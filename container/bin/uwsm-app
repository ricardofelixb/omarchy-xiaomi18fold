#!/usr/bin/env bash
set -euo pipefail
# ARM container port: stand-in for uwsm-app.
# The container has no systemd --user and its D-Bus bus belongs to the Debian host, so the real
# uwsm-app would hand the program to the host's systemd (running it on the host, not in the container).
# This drops uwsm-app's own options and execs the command that follows in the current environment.
# Usage compatible with: uwsm-app [-s b|s|a] [-t scope|service] [-a app_name] [-S out|err|both] -- command [args...]
while (($#)); do
  case "$1" in
    --) shift; break ;;
    -s|-t|-a|-u|-d|-S)
      (($# >= 2)) || { echo "uwsm-app: option requires an argument" >&2; exit 2; }
      shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
(($#)) || { echo "uwsm-app (stand-in): no command to run" >&2; exit 1; }
exec "$@"
