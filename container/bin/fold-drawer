#!/bin/bash
# Fold: the app launcher is Omarchy's own apps menu (omarchy-menu, route "apps"),
# opened from the 3/4-finger swipe down, the dock's launcher button and the window menu.
# Usage: fold-drawer [toggle|open|close]   (daemon/restart are accepted and do nothing:
# the Omarchy shell is already resident)
case ${1:-toggle} in
  toggle) exec omarchy-menu toggle apps ;;
  open)   exec omarchy-menu summon apps ;;
  close)  exec omarchy-menu close ;;
  daemon|restart) exit 0 ;;
  *) echo "usage: fold-drawer [toggle|open|close]" >&2; exit 2 ;;
esac
