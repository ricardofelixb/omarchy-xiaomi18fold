#!/usr/bin/env bash
set -euo pipefail
# The container has no systemd to run Omarchy's audio stack, so start it here:
# PipeWire, WirePlumber (opens the sound card) and the PulseAudio socket pactl/Omarchy talk to.
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
mkdir -p "$HOME/.local/state/omarchy-alarm"
exec 9>"$XDG_RUNTIME_DIR/omarchy-audio-autostart.lock"
flock -n 9 || exit 0
start() {
  pgrep -u "$(id -u)" -x "$1" >/dev/null || "$1" >>"$HOME/.local/state/omarchy-alarm/$1.log" 2>&1 &
}
start pipewire
for ((attempt=0; attempt<50; attempt++)); do
  [[ -S $XDG_RUNTIME_DIR/pipewire-0 ]] && break
  sleep 0.1
done
start wireplumber
start pipewire-pulse
wait
