#!/usr/bin/env bash
# Update System for the Fold's Arch Linux ARM container; omarchy-update runs this (patch 0007).
# Moves the arm-port branch to the newest Omarchy release, upgrades packages from Arch Linux ARM,
# runs Omarchy migrations except boot/kernel ones, then re-applies the fold config.
# No [omarchy] repo, keyring refresh, snapshot, boot gate, kernel check, mise or reboot prompt here.
set -uo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
FOLD_ROOT=${FOLD_ROOT:-$HOME/.local/share/fold}
FOLD_STATE=${FOLD_STATE:-$HOME/.local/state/fold}
FOLD_SKIP_FILE=${FOLD_SKIP_FILE:-$FOLD_ROOT/container/update-skip-migrations.txt}
OMARCHY_REMOTE=${FOLD_OMARCHY_REMOTE:-https://github.com/omacom/omarchy.git}
MIGRATION_STATE=${OMARCHY_MIGRATION_STATE:-$HOME/.local/state/omarchy/migrations}
FOLD_PATCHES=$FOLD_ROOT/patches
export OMARCHY_PATH FOLD_PATCHES OMARCHY_MIGRATION_STATE=$MIGRATION_STATE PATH="$OMARCHY_PATH/bin:$HOME/.local/bin:$PATH"

say() { printf '\e[32m\n%s\e[0m\n' "$*"; }
warn() { printf '\e[33m%s\e[0m\n' "$*" >&2; }

latest_tag() {
  timeout 30 git ls-remote --tags --refs "$OMARCHY_REMOTE" 'v*' 2>/dev/null |
    sed 's#.*refs/tags/##' | grep -E '^v[0-9]+(\.[0-9]+)+$' | sort -V | tail -n 1
}

# Skip-listed migrations are marked done without running. A failed one is reported and left pending.
run_migrations() {
  local name skip failed=()
  # Without the skip list a boot/kernel or sudo-resetting migration would run, so leave all pending.
  skip=$(cat -- "$FOLD_SKIP_FILE" 2>/dev/null) && [[ -n $skip ]] || { warn "Skip list $FOLD_SKIP_FILE is missing or unreadable; migrations left pending. Rerun container/install.sh."; return 1; }
  mkdir -p "$MIGRATION_STATE"
  while read -r name; do
    [[ -n $name ]] || continue
    if grep -Eq "^${name%.sh}([[:space:]]|\$)" <<< "$skip"; then
      echo "Skipping migration ${name%.sh} (on the fold skip list, marked done)"
      touch "$MIGRATION_STATE/$name"; continue
    fi
    echo -e "\e[32m\nRunning migration (${name%.sh})\e[0m"
    if bash -euo pipefail "$OMARCHY_PATH/migrations/$name" < /dev/null; then touch "$MIGRATION_STATE/$name"; else failed+=("${name%.sh}"); fi
  done < <(omarchy-migrate --pending || true)
  ((${#failed[@]} == 0)) || warn "Migrations that failed and will retry next update: ${failed[*]}"
}

reapply_fold_config() {
  [[ -r $FOLD_ROOT/lib/config-overlay.sh ]] || { warn "No fold payload in $FOLD_ROOT; rerun container/install.sh to restore fold config."; return 1; }
  # shellcheck disable=SC2034 # ROOT is read by the sourced overlay
  ( ROOT=$FOLD_ROOT FOLD_KEEP_EXISTING=1; source "$FOLD_ROOT/lib/config-overlay.sh"; install_config_overlay )
}

main() {
  local tag status=0 move_failed=0
  sudo true || return 1
  mkdir -p "$FOLD_STATE"
  say 'Update Omarchy'
  # shellcheck source=../../lib/omarchy-move.sh
  if ! source "$FOLD_ROOT/lib/omarchy-move.sh" 2>/dev/null; then warn "No fold payload in $FOLD_ROOT; rerun container/install.sh. Omarchy left as it is."; move_failed=1
  elif tag=$(latest_tag) && [[ -n $tag ]]; then omarchy_move_to "$tag" || move_failed=1
  else warn 'Could not reach github.com; Omarchy release updates need a global network. Updating packages only.'; fi
  # The packaged-path helpers come from the checkout, so refresh them whether or not it moved.
  if declare -F omarchy_install_packaged_helpers >/dev/null; then omarchy_install_packaged_helpers || warn 'Packaged Omarchy helpers were not all refreshed; rerun container/install.sh.'; fi
  # The new release can bundle new app icons; the checkout is on whatever release it ended on.
  declare -F omarchy_install_app_icons >/dev/null && { omarchy_install_app_icons || warn 'Bundled app icons were not refreshed.'; }
  say 'Update system packages (Arch Linux ARM)'
  if ! sudo env OMARCHY_UPDATE_PACMAN=1 OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu --noconfirm < /dev/null; then
    warn 'Package update failed; migrations and the fold config were not touched.'; return 1
  fi
  command -v fold-hyprgrass-build >/dev/null && { fold-hyprgrass-build || warn 'hyprgrass plugin build failed (touch gestures may be off).'; }
  if ((move_failed)); then warn 'Omarchy did not move to the new release, so its migrations were not run.'; else run_migrations || status=1; fi
  say 'Update AUR packages'
  if command -v yay >/dev/null; then GOPATH=$HOME/.cache/go yay -Sua --noconfirm < /dev/null || warn 'AUR update failed (nonfatal).'; fi
  say 'Re-apply fold config'
  reapply_fold_config || status=1
  # The session and its bar run from the /usr/share/omarchy link; a restart by another path finds no shell.
  local session_path=/usr/share/omarchy
  [[ -d $session_path/shell ]] || session_path=$OMARCHY_PATH
  OMARCHY_PATH=$session_path omarchy-restart-shell || warn 'Omarchy shell did not restart; log out and back in to load the new shell.'
  say 'Update complete. No reboot needed.'
  return $status
}

main "$@"
exit $?
