#!/usr/bin/env bash
# Update System for the Fold's Arch Linux ARM container; omarchy-update runs this (patch 0007).
# Moves the arm-port branch to the newest Omarchy release, upgrades packages from Arch Linux ARM,
# runs Omarchy migrations except boot/kernel ones, then re-applies the fold config.
# No [omarchy] repo, keyring refresh, snapshot, boot gate, kernel check, mise or reboot prompt here.
set -uo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
FOLD_ROOT=${FOLD_ROOT:-$HOME/.local/share/fold}
FOLD_STATE=${FOLD_STATE:-$HOME/.local/state/fold}
FOLD_SKIP_FILE=${FOLD_SKIP_FILE:-$FOLD_ROOT/container/update-skip-migrations.txt}
OMARCHY_REMOTE=${FOLD_OMARCHY_REMOTE:-https://github.com/omacom/omarchy.git}
MIGRATION_STATE=${OMARCHY_MIGRATION_STATE:-$HOME/.local/state/omarchy/migrations}
export OMARCHY_PATH OMARCHY_MIGRATION_STATE=$MIGRATION_STATE PATH="$OMARCHY_PATH/bin:$HOME/.local/bin:$PATH"

say() { printf '\e[32m\n%s\e[0m\n' "$*"; }
warn() { printf '\e[33m%s\e[0m\n' "$*" >&2; }
og() { git -C "$OMARCHY_PATH" -c advice.detachedHead=false -c user.name=omarchy-alarm-nspawn -c user.email=noreply@example.com "$@"; }

latest_tag() {
  timeout 30 git ls-remote --tags --refs "$OMARCHY_REMOTE" 'v*' 2>/dev/null |
    sed 's#.*refs/tags/##' | grep -E '^v[0-9]+(\.[0-9]+)+$' | sort -V | tail -n 1
}

# Prints "<tag> <commit>" for the release arm-port sits on: the recorded one, else the nearest tag.
current_base() {
  local tag
  if [[ -s $FOLD_STATE/omarchy-base ]]; then cat "$FOLD_STATE/omarchy-base"; return; fi
  tag=$(og describe --tags --abbrev=0 --match 'v[0-9]*' arm-port 2>/dev/null) || return 1
  echo "$tag $(og rev-parse "$tag^{commit}")"
}

# Rebuild arm-port from the fork's own patches when the rebase conflicts and they target this tag.
apply_shipped_patches() {
  local new=$1 patch
  [[ $(tr -d '\n' < "$FOLD_ROOT/patches/BASE" 2>/dev/null) == "$new" ]] || return 1
  og switch -q --detach "$new" || return 1
  for patch in "$FOLD_ROOT"/patches/*.patch; do
    og am -q "$patch" >/dev/null 2>&1 || { og am --abort >/dev/null 2>&1; og switch -q arm-port; return 1; }
  done
  og branch -f arm-port HEAD >/dev/null && og switch -q arm-port
}

move_omarchy() {
  local tag=$1 old_tag old new tip
  read -r old_tag old < <(current_base) || { warn 'Cannot tell which Omarchy release arm-port is on; Omarchy left as it is.'; return 1; }
  if [[ $old_tag == "$tag" || $(printf '%s\n%s\n' "$old_tag" "$tag" | sort -V | tail -n 1) == "$old_tag" ]]; then
    echo "Omarchy $old_tag is the latest release."; return 0
  fi
  if [[ $(og branch --show-current) != arm-port || -n $(og status --porcelain) ]]; then
    warn "Omarchy $tag is out, but the Omarchy checkout is not a clean arm-port; your system is unchanged."; return 1
  fi
  og fetch -q --depth 1 "$OMARCHY_REMOTE" "refs/tags/$tag:refs/tags/$tag" || { warn "Could not fetch Omarchy $tag; your system is unchanged."; return 1; }
  new=$(og rev-parse "$tag^{commit}") && tip=$(og rev-parse arm-port) || return 1
  if ! og rebase -q --onto "$new" "$old" arm-port >/dev/null 2>&1; then
    og rebase --abort >/dev/null 2>&1
    if ! apply_shipped_patches "$new"; then
      warn "Omarchy $tag needs a fold update; your system is unchanged."; return 1
    fi
  fi
  og branch -f arm-port-prev "$tip" >/dev/null
  echo "$tag $new" > "$FOLD_STATE/omarchy-base"
  echo "Omarchy moved from $old_tag to $tag (previous arm-port kept as arm-port-prev)."
}

# Skip-listed migrations are marked done without running. A failed one is reported and left pending.
run_migrations() {
  local name failed=()
  mkdir -p "$MIGRATION_STATE"
  while read -r name; do
    [[ -n $name ]] || continue
    if grep -Eq "^${name%.sh}([[:space:]]|\$)" "$FOLD_SKIP_FILE" 2>/dev/null; then
      echo "Skipping migration ${name%.sh} (boot/kernel, not used in the container)"
      touch "$MIGRATION_STATE/$name"; continue
    fi
    echo -e "\e[32m\nRunning migration (${name%.sh})\e[0m"
    if bash -euo pipefail "$OMARCHY_PATH/migrations/$name" < /dev/null; then touch "$MIGRATION_STATE/$name"; else failed+=("${name%.sh}"); fi
  done < <(omarchy-migrate --pending || true)
  ((${#failed[@]} == 0)) || warn "Migrations that failed and will retry next update: ${failed[*]}"
}

reapply_fold_config() {
  [[ -r $FOLD_ROOT/lib/config-overlay.sh ]] || { warn "No fold payload in $FOLD_ROOT; rerun container/install.sh to restore fold config."; return 1; }
  # shellcheck disable=SC2034 # ROOT is read by the sourced overlay
  ( ROOT=$FOLD_ROOT; source "$FOLD_ROOT/lib/config-overlay.sh"; install_config_overlay )
}

main() {
  local tag status=0
  sudo true || return 1
  mkdir -p "$FOLD_STATE"
  say 'Update Omarchy'
  if tag=$(latest_tag) && [[ -n $tag ]]; then move_omarchy "$tag"
  else warn 'Could not reach github.com; Omarchy release updates need a global network. Updating packages only.'; fi
  say 'Update system packages (Arch Linux ARM)'
  if ! sudo env OMARCHY_UPDATE_PACMAN=1 OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu --noconfirm < /dev/null; then
    warn 'Package update failed; migrations and the fold config were not touched.'; return 1
  fi
  command -v fold-hyprgrass-build >/dev/null && { fold-hyprgrass-build || warn 'hyprgrass plugin build failed (touch gestures may be off).'; }
  run_migrations
  say 'Update AUR packages'
  if command -v yay >/dev/null; then yay -Sua --noconfirm < /dev/null || warn 'AUR update failed (nonfatal).'; fi
  say 'Re-apply fold config'
  reapply_fold_config || status=1
  omarchy-restart-shell || warn 'Omarchy shell did not restart; log out and back in to load the new shell.'
  say 'Update complete. No reboot needed.'
  return $status
}

main "$@"
exit $?
